{
  "name": "aura-3d",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mobile": "turbo run mobile",
    "start": "turbo run dev --parallel",
    "backend": "turbo run backend",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.9.6",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.182.0",
    "react-native-gesture-handler": "~2.30.0"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.182.0",
    "react-native-gesture-handler": "~2.30.0"
  }
}
